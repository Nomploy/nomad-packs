app {
  url = "https://www.consul.io"
}

pack {
  name        = "consul"
  description = "Consul — HashiCorp's service networking layer: a key/value store, service discovery, health checking, and DNS. Deployed here as a single-node server with the web UI, host-networked with a data volume. Handy alongside Nomad for app config and cross-service discovery."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/consul"
  version     = "0.1.0"
}
