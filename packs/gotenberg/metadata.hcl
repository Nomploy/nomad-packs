app {
  url = "https://gotenberg.dev"
}

pack {
  name        = "gotenberg"
  description = "Gotenberg — a stateless, Docker-based API for converting HTML, Markdown, Office documents, and URLs into PDFs (and merging/transforming them) via Chromium and LibreOffice. Deployed as a host-networked Nomad service; stateless, so it can scale to multiple instances."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/gotenberg"
  version     = "0.1.0"
}
