---
const {
  title = "Nomploy Nomad Packs",
  description = "Browse the Nomploy curated Nomad Pack registry — batteries-included, one-click infrastructure packs for Nomad: databases, observability, dev tools, and apps you self-host.",
  jsonld = null,
} = Astro.props;
const base = import.meta.env.BASE_URL;

// SEO: absolute canonical + social image derived from the configured site.
const site = Astro.site ?? new URL("https://packs.nomploy.com");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("og.png", site).href;

// Configurable Plausible analytics — only injected when PLAUSIBLE_DOMAIN is set
// at build time (CI repo variable / env). No tracking otherwise.
const plausibleDomain = process.env.PLAUSIBLE_DOMAIN || "";
const plausibleSrc = process.env.PLAUSIBLE_SRC || "https://plausible.io/js/script.js";

// Site-level structured data, always emitted; pages can add their own via `jsonld`.
const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Nomploy Nomad Packs",
  url: site.href,
  description,
};
const graph = jsonld ? [siteLd, jsonld] : [siteLd];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nomploy Nomad Packs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nomploy Nomad Packs" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0e1116" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%93%A6%3C/text%3E%3C/svg%3E" />
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(graph).replace(/</g, "\\u003c")}</script>`} />
    {plausibleDomain && (
      <script is:inline defer data-domain={plausibleDomain} src={plausibleSrc}></script>
    )}
    <script is:inline>
      // Apply the saved theme before paint to avoid a flash.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="home" href={base}><span class="logo-mark">📦</span> Nomploy Nomad Packs</a>
        <button id="theme-toggle" class="icon-btn" title="Toggle theme" aria-label="Toggle theme">
          <span class="t-dark">🌙</span><span class="t-light">☀️</span>
        </button>
      </header>
      <slot />
      <footer>
        Generated from <a href="https://github.com/Nomploy/nomad-packs">github.com/Nomploy/nomad-packs</a>
        · <a href={`${base}api/packs.json`}>JSON API</a>
      </footer>
    </div>

    <script is:inline>
      const btn = document.getElementById("theme-toggle");
      const effective = () =>
        document.documentElement.dataset.theme ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      btn?.addEventListener("click", () => {
        const next = effective() === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f7f9; --card: #fff; --text: #1c2024; --muted: #5b6570; --border: #e2e6ea;
    --accent: #2f6feb; --accent-fg: #fff; --chip: #eef1f4; --code-bg: #f0f2f5;
    --tile-bg: #ffffff; --tile-border: #e2e6ea;
    --shadow: 0 1px 2px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.05);
  }
  /* dark theme vars, shared by system-dark and the manual toggle */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0e1116; --card: #171b21; --text: #e6e9ee; --muted: #9aa4b0; --border: #252b33;
      --accent: #5b8cff; --accent-fg: #0e1116; --chip: #1e242c; --code-bg: #11151a;
      --tile-bg: #e9edf2; --tile-border: #cdd4dd;
      --shadow: 0 1px 2px rgba(0,0,0,.4), 0 6px 20px rgba(0,0,0,.35);
    }
  }
  :root[data-theme="dark"] {
    --bg: #0e1116; --card: #171b21; --text: #e6e9ee; --muted: #9aa4b0; --border: #252b33;
    --accent: #5b8cff; --accent-fg: #0e1116; --chip: #1e242c; --code-bg: #11151a;
    --tile-bg: #e9edf2; --tile-border: #cdd4dd;
    --shadow: 0 1px 2px rgba(0,0,0,.4), 0 6px 20px rgba(0,0,0,.35);
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  code, kbd, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  header { padding: 28px 0 4px; display: flex; align-items: center; gap: 12px; }
  .home { font-size: 22px; font-weight: 700; letter-spacing: -.02em; color: var(--text); display: inline-flex; align-items: center; gap: 8px; }
  .home:hover { text-decoration: none; }
  .icon-btn { margin-left: auto; background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 9px; width: 38px; height: 38px; font-size: 17px; cursor: pointer; line-height: 1; }
  .icon-btn:hover { border-color: var(--accent); }
  .t-light { display: none; } .t-dark { display: inline; }
  :root[data-theme="dark"] .t-light { display: inline; } :root[data-theme="dark"] .t-dark { display: none; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .t-light { display: inline; } :root:not([data-theme="light"]) .t-dark { display: none; } }
  footer { color: var(--muted); font-size: 12.5px; padding: 24px 0 48px; border-top: 1px solid var(--border); margin-top: 40px; }

  .addcmd { display: flex; gap: 8px; align-items: stretch; flex-wrap: wrap; }
  .cmd { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 9px 12px; font-size: 13px; overflow: auto; white-space: nowrap; flex: 1; min-width: 260px; font-family: ui-monospace, monospace; }
  .copy { background: var(--accent); color: var(--accent-fg); border: 0; border-radius: 8px; padding: 0 14px; font-size: 13px; font-weight: 600; cursor: pointer; }
  .copy:active { transform: translateY(1px); }

  .ver { font-size: 11px; font-weight: 600; color: var(--muted); background: var(--chip); border-radius: 6px; padding: 2px 6px; }
  .cat { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }

  /* logo tiles */
  .logo { width: 40px; height: 40px; border-radius: 10px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; background: var(--tile-bg); border: 1px solid var(--tile-border); }
  .logo.mono { color: #fff; font-weight: 700; font-size: 18px; border: 0; }
  .logo svg { width: 22px; height: 22px; }
  .logo-lg { width: 52px; height: 52px; border-radius: 13px; }
  .logo-lg svg { width: 28px; height: 28px; }
  .logo-lg.mono { font-size: 24px; }

  .vartable { width: 100%; border-collapse: collapse; font-size: 13px; margin: 10px 0; }
  .vartable th, .vartable td { border: 1px solid var(--border); padding: 7px 9px; text-align: left; vertical-align: top; }
  .vartable td.mono { font-family: ui-monospace, monospace; white-space: nowrap; }
  .section-title { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 28px 0 8px; }

  /* rendered markdown */
  .md h1 { font-size: 22px; border-bottom: 1px solid var(--border); padding-bottom: 6px; letter-spacing: -.01em; }
  .md h2 { font-size: 18px; margin-top: 24px; }
  .md h3 { font-size: 16px; }
  .md pre { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 12px; overflow: auto; font-size: 13px; }
  .md code { background: var(--code-bg); border-radius: 4px; padding: 1px 5px; font-size: .9em; }
  .md pre code { background: none; padding: 0; }
  .md table { border-collapse: collapse; width: 100%; font-size: 13px; margin: 12px 0; }
  .md th, .md td { border: 1px solid var(--border); padding: 6px 9px; text-align: left; vertical-align: top; }
  .md img { max-width: 100%; }
</style>
