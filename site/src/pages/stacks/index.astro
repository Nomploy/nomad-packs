---
import Base from "../../layouts/Base.astro";
import { getStacks } from "../../lib/stacks.js";
import { getPacks } from "../../lib/packs.js";

const stacks = getStacks();
const packs = await getPacks();
const nameOf = Object.fromEntries(packs.map((p) => [p.id, p.name]));
const base = import.meta.env.BASE_URL;

const site = Astro.site ?? new URL("https://packs.nomploy.com");
const jsonld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Nomploy common stacks",
  itemListElement: stacks.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: s.name,
    url: new URL(`stacks/${s.id}/`, site).href,
  })),
};
---

<Base
  title="Common stacks — Nomploy Nomad Packs"
  description="Ready-made, conflict-free bundles of Nomad Packs — observability, local AI, media server, databases, and more — deployable in a few commands."
  jsonld={jsonld}
>
  <section class="hero">
    <h1>Common stacks</h1>
    <p class="lede">
      Curated bundles of packs that work well together on one node — each verified free of
      host-port conflicts. Open one in the
      <a href={`${base}stack/`}>Stack builder</a> to tweak it, or copy the deploy commands.
    </p>
  </section>

  <div class="grid">
    {stacks.map((s) => (
      <a class="scard" href={`${base}stacks/${s.id}/`}>
        <div class="cat">{s.tagline}</div>
        <h3>{s.name}</h3>
        <p>{s.description}</p>
        <div class="chips">
          {s.packs.map((id) => <span class="chip">{nameOf[id] || id}</span>)}
        </div>
        <div class="foot"><span>{s.packs.length} packs</span><span class="arrow">→</span></div>
      </a>
    ))}
  </div>

  <p class="back"><a href={base}>← Back to the catalog</a></p>
</Base>

<style>
  .hero { padding: 18px 20px; margin: 12px 0 16px; border: 1px solid var(--border); border-radius: 16px; background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 8%, var(--card)) 0%, var(--card) 60%); position: relative; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--brand-grad); }
  .hero h1 { margin: 2px 0 6px; font-size: 26px; letter-spacing: -.02em; background: var(--brand-grad); -webkit-background-clip: text; background-clip: text; color: transparent; display: inline-block; }
  .lede { color: var(--muted); margin: 0; max-width: 760px; }
  .lede a { color: var(--accent); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; padding: 6px 0 8px; }
  .scard { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; box-shadow: var(--shadow); color: inherit; display: flex; flex-direction: column; transition: transform .08s ease, border-color .12s ease; }
  .scard:hover { transform: translateY(-2px); border-color: var(--accent); text-decoration: none; }
  .cat { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .scard h3 { margin: 4px 0 6px; font-size: 18px; letter-spacing: -.01em; }
  .scard p { margin: 0 0 12px; color: var(--muted); font-size: 13.5px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
  .chip { background: var(--chip); border: 1px solid var(--border); border-radius: 999px; padding: 3px 10px; font-size: 12px; color: var(--muted); }
  .foot { margin-top: auto; color: var(--muted); font-size: 12px; display: flex; align-items: center; }
  .foot .arrow { margin-left: auto; }
  .back { margin: 22px 0 0; font-size: 13px; }
</style>
