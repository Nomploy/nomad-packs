app {
  url = "https://babybuddy.app"
}

pack {
  name        = "babybuddy"
  description = "Baby Buddy — a self-hosted tracker to help caregivers log a baby's sleep, feedings, diaper changes, tummy time and more, with charts and timers. Deployed as a single host-networked Nomad service (LinuxServer image) with SQLite storage."
