app {
  url = "https://rqlite.io"
}

pack {
  name        = "rqlite"
  description = "rqlite — a lightweight, distributed relational database built on SQLite with Raft consensus for high availability. Get SQLite's simplicity plus fault-tolerant replication and an easy HTTP API. Deployed as a host-networked single-node Nomad service (join more nodes to form a cluster) with a persistent data volume."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/rqlite"
  version     = "0.1.0"
}
