app {
  url = "https://github.com/butlerx/wetty"
}

pack {
  name        = "wetty"
  description = "WeTTY — a terminal in your browser: a web front-end that opens an SSH session to a host over HTTP, so you can get a shell from anywhere without a native SSH client. Deployed as a host-networked, stateless Nomad service that connects to an SSH server you specify."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/wetty"
  version     = "0.1.0"
}
