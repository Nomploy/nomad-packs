app {
  url = "https://sosedoff.github.io/pgweb/"
}

pack {
  name        = "pgweb"
  description = "pgweb — a fast, lightweight, browser-based PostgreSQL client: browse tables, run queries, inspect schemas, and export results. Deployed as a stateless host-networked Nomad service in sessions mode, so each user enters their own connection in the UI. Pairs with the postgres pack."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/pgweb"
  version     = "0.1.0"
}
