---
import Base from "../../layouts/Base.astro";
import { getStacks } from "../../lib/stacks.js";
import { getPacks, REGISTRY_URL } from "../../lib/packs.js";

export async function getStaticPaths() {
  const packs = await getPacks();
  return getStacks().map((s) => ({ params: { id: s.id }, props: { stack: s, packs } }));
}

const { stack, packs } = Astro.props;
const base = import.meta.env.BASE_URL;
const byId = Object.fromEntries(packs.map((p) => [p.id, p]));
const members = stack.packs.map((id) => byId[id]).filter(Boolean);

// Combined port map (build-time) + conflict flags.
const portUsers = {};
for (const p of members) for (const pt of p.facts.ports) {
  const n = parseInt(pt.port, 10);
  if (!Number.isNaN(n)) (portUsers[n] ||= []).push(p.name);
}
const ports = Object.keys(portUsers).map(Number).sort((a, b) => a - b);
const conflicts = ports.filter((n) => portUsers[n].length > 1);
const totalTasks = members.reduce((s, p) => s + (p.facts.tasks || 0), 0);
const totalVolumes = members.reduce((s, p) => s + p.facts.volumes.length, 0);
const totalMem = members.reduce((s, p) => s + (p.facts.memory || 0), 0);
const ramLabel = totalMem >= 1024 ? `${(totalMem / 1024).toFixed(1)} GB` : `${totalMem} MB`;

const cmds = [`nomad-pack registry add nomploy ${REGISTRY_URL}`, ...members.map((p) => `nomad-pack run ${p.id} --registry nomploy`)].join("\n");

const site = Astro.site ?? new URL("https://packs.nomploy.com");
const jsonld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: stack.name,
  description: stack.description,
  itemListElement: members.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: p.name,
    url: new URL(`packs/${p.id}/`, site).href,
  })),
};
const builderHref = `${base}stack/?packs=${stack.packs.join(",")}`;
---

<Base title={`${stack.name} — Nomploy Nomad Packs`} description={stack.description} jsonld={jsonld}>
  <p class="crumb"><a href={`${base}stacks/`}>← All stacks</a></p>

  <div class="head">
    <div>
      <div class="cat">{stack.tagline}</div>
      <h1>{stack.name}</h1>
    </div>
  </div>
  <p class="desc">{stack.description}</p>

  <div class="facts">
    <span class="fact"><span class="fk">{members.length}</span> packs</span>
    <span class="fact"><span class="fk">{totalTasks}</span> tasks</span>
    <span class="fact"><span class="fk">{ports.length}</span> ports</span>
    <span class="fact"><span class="fk">{totalVolumes}</span> volumes</span>
    <span class="fact"><span class="fk">{ramLabel}</span> RAM</span>
    {conflicts.length === 0 ? (
      <span class="fact ok">✓ no port conflicts</span>
    ) : (
      <span class="fact bad">⚠ {conflicts.length} port conflicts</span>
    )}
  </div>

  <p class="links"><a href={builderHref}>Open in Stack builder →</a></p>

  <div class="section-title">Deploy</div>
  <div class="deployrow">
    <button class="deploy" id="deploybtn" data-packs={stack.packs.join(",")} data-stack={stack.id} data-registry="github.com/Nomploy/nomad-packs">Deploy stack to Nomploy →</button>
    <button class="deploy-cfg" id="deploycfg" type="button">set panel…</button>
  </div>
  {stack.profiles && stack.profiles.length > 0 && (
    <div class="profiles">
      <span class="plabel">Profiles</span>
      {stack.profiles.map((pr) => (
        <div class="profrow">
          <button class="deploy ghost" data-packs={pr.packs.join(",")} data-stack={`${stack.id}:${pr.id}`} data-registry="github.com/Nomploy/nomad-packs">Deploy “{pr.name}” →</button>
          <span class="prpacks">{pr.packs.join(" · ")}</span>
        </div>
      ))}
    </div>
  )}
  <p class="olhint">…or copy the commands and run them yourself:</p>
  <div class="addcmd">
    <pre class="cmd" id="cmds">{cmds}</pre>
    <button class="copy" data-copy="#cmds">Copy</button>
  </div>

  <div class="section-title">Packs</div>
  <div class="grid">
    {members.map((p) => (
      <a class="pcard" href={`${base}packs/${p.id}/`}>
        <div class="phead">
          {p.icon.kind === "brand" ? (
            <div class="logo" style={`color:${p.icon.hex}`} set:html={p.iconSvg} />
          ) : p.icon.kind === "custom" ? (
            <div class="logo custom" set:html={p.iconSvg} />
          ) : (
            <div class="logo mono" style={`background:${p.icon.color}`}>{p.icon.text}</div>
          )}
          <div class="pmeta">
            <div class="cat">{p.category}</div>
            <h3>{p.name}</h3>
          </div>
        </div>
        <p>{p.description}</p>
        <div class="foot">
          <span>{p.facts.ports.map((x) => x.port).join(" · ") || "—"}</span>
          <span class="arrow">→</span>
        </div>
      </a>
    ))}
  </div>

  <div class="section-title">Variables to set</div>
  <div class="setvars">
    {members.map((p) => {
      const vs = p.variables.filter((v) => v.placeholder || v.sensitive);
      return (
        <div class="svrow">
          <a class="svp" href={`${base}packs/${p.id}/`}>{p.name}</a>{" "}
          {vs.length === 0 ? (
            <span class="muted">sensible defaults</span>
          ) : (
            <span class="svv">{vs.map((v) => <code class={v.placeholder ? "must" : ""}>{v.name}</code>)}</span>
          )}
        </div>
      );
    })}
  </div>
  <p class="muted small">Highlighted variables are placeholders (passwords, secret keys) you should change before production. Open a pack for its full variable table and a copy-paste <code>values.hcl</code>.</p>

  <div class="section-title">Host ports</div>
  <div class="portmap">
    {ports.map((n) => (
      <div class={`pmrow ${portUsers[n].length > 1 ? "bad" : ""}`}>
        <span class="pp">{n}</span>
        <span class="pu">{portUsers[n].join(", ")}{portUsers[n].length > 1 ? " ⚠ conflict" : ""}</span>
      </div>
    ))}
  </div>

  <p class="back"><a href={base}>← Back to the catalog</a></p>
</Base>

<style>
  .crumb { margin: 16px 0 0; font-size: 13px; }
  .head h1 { margin: 2px 0 0; font-size: 26px; letter-spacing: -.02em; }
  .cat { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .desc { color: var(--muted); margin: 8px 0 14px; max-width: 760px; }
  .links { margin: 4px 0 0; font-size: 14px; }
  .links a { font-weight: 600; }

  .facts { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 4px; }
  .fact { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--muted); background: var(--chip); border: 1px solid var(--border); border-radius: 8px; padding: 4px 10px; }
  .fact .fk { font-weight: 700; color: var(--text); font-family: ui-monospace, monospace; }
  .fact.ok { color: var(--accent); }
  .fact.bad { color: #b42318; }
  :root[data-theme="dark"] .fact.bad { color: #ff9d94; }

  .section-title { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 26px 0 8px; }
  .addcmd { display: flex; gap: 8px; align-items: flex-start; }
  .cmd { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; font-size: 12.5px; overflow: auto; white-space: pre; font-family: ui-monospace, monospace; margin: 0; flex: 1; }

  .deployrow { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 4px 0 10px; }
  .deploy { background: var(--accent); color: #fff; border: 0; border-radius: 8px; padding: 10px 18px; font-size: 14px; font-weight: 700; cursor: pointer; }
  .deploy:hover { filter: brightness(1.06); }
  .deploy.ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); font-weight: 600; padding: 7px 14px; font-size: 13px; }
  .deploy-cfg { background: none; border: 0; padding: 0; color: var(--muted); font-size: 12.5px; cursor: pointer; text-decoration: underline; }
  .deploy-cfg:hover { color: var(--accent); }
  .profiles { margin: 2px 0 10px; }
  .profiles .plabel { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .profrow { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 6px 0; }
  .prpacks { font-size: 12px; color: var(--muted); font-family: ui-monospace, monospace; }
  .olhint { color: var(--muted); font-size: 12.5px; margin: 10px 0 6px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .pcard { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; box-shadow: var(--shadow); color: inherit; display: flex; flex-direction: column; transition: transform .08s ease, border-color .12s ease; }
  .pcard:hover { transform: translateY(-2px); border-color: var(--accent); text-decoration: none; }
  .phead { display: flex; gap: 12px; align-items: center; margin-bottom: 10px; }
  .pmeta { min-width: 0; }
  .pcard h3 { margin: 2px 0 0; font-size: 16px; }
  .pcard p { margin: 0; color: var(--muted); font-size: 13px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { margin-top: 12px; color: var(--muted); font-size: 12px; display: flex; align-items: center; font-family: ui-monospace, monospace; }
  .foot .arrow { margin-left: auto; }
  .logo { width: 40px; height: 40px; border-radius: 10px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; background: var(--tile-bg); border: 1px solid var(--tile-border); }
  .logo.mono { color: #fff; font-weight: 700; font-size: 18px; border: 0; }
  .logo svg { width: 22px; height: 22px; }

  .portmap { display: flex; flex-direction: column; gap: 4px; }
  .pmrow { display: flex; gap: 8px; font-size: 13px; }
  .pmrow .pp { font-family: ui-monospace, monospace; font-weight: 700; min-width: 58px; }
  .pmrow .pu { color: var(--muted); }
  .pmrow.bad, .pmrow.bad .pp { color: #b42318; }
  :root[data-theme="dark"] .pmrow.bad, :root[data-theme="dark"] .pmrow.bad .pp { color: #ff9d94; }
  .back { margin: 24px 0 0; font-size: 13px; }
  .small { font-size: 12px; }
  .setvars { display: flex; flex-direction: column; gap: 6px; }
  .svrow { font-size: 13.5px; line-height: 1.6; }
  .svp { font-weight: 600; }
  .svv code { font-family: ui-monospace, monospace; font-size: 12px; background: var(--code-bg); border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px; margin: 0 3px 3px 0; display: inline-block; color: var(--muted); }
  .svv code.must { color: #b45309; border-color: #f59e0b66; background: #f59e0b1a; }
  :root[data-theme="dark"] .svv code.must { color: #fbbf24; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .svv code.must { color: #fbbf24; } }
</style>

<script>
  document.querySelectorAll(".copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = document.querySelector(btn.dataset.copy);
      try {
        await navigator.clipboard.writeText(el.textContent);
        const o = btn.textContent; btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = o), 1200);
      } catch (e) {}
    });
  });

  // "Deploy stack to Nomploy": open the whole stack (or a profile's pack set) in
  // the user's own panel. Panel URL is per-visitor (public registry), remembered
  // in localStorage; first use prompts for it. Deep-links to
  // /dashboard/deploy-stack?packs=…&registry=…&stack=…
  const PANEL_KEY = "nomploy_panel_url";
  const getPanel = () => {
    try { return localStorage.getItem(PANEL_KEY) || ""; } catch (e) { return ""; }
  };
  const askPanel = () => {
    const cur = getPanel();
    const v = prompt("Your Nomploy panel URL (e.g. https://nomploy.example.com):", cur || "https://");
    if (v == null) return cur;
    const url = v.trim().replace(/\/+$/, "");
    if (!/^https?:\/\/.+/.test(url)) {
      if (v.trim()) alert("Please enter a full URL starting with http:// or https://");
      return cur;
    }
    try { localStorage.setItem(PANEL_KEY, url); } catch (e) {}
    return url;
  };
  document.querySelectorAll(".deploy[data-packs]").forEach((btn) => {
    btn.addEventListener("click", () => {
      let panel = getPanel();
      if (!panel) panel = askPanel();
      if (!panel) return;
      const packs = btn.dataset.packs;
      const registry = btn.dataset.registry;
      const stack = btn.dataset.stack || "";
      const u = `${panel}/dashboard/deploy-stack?packs=${encodeURIComponent(packs)}&registry=${encodeURIComponent(registry)}${stack ? `&stack=${encodeURIComponent(stack)}` : ""}`;
      window.open(u, "_blank", "noopener");
    });
  });
  const dc = document.getElementById("deploycfg");
  if (dc) dc.addEventListener("click", () => askPanel());
</script>
