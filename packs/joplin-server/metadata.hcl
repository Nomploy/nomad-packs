app {
  url = "https://joplinapp.org"
}

pack {
  name        = "joplin-server"
  description = "Joplin Server — the self-hosted sync backend for the Joplin note-taking apps: keep your notes, notebooks, and attachments in sync across desktop and mobile with end-to-end encryption, and share notebooks with others. Deployed as an all-in-one host-networked Nomad job: the Joplin Server app plus a PostgreSQL sidecar with a persistent database volume."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/joplin-server"
  version     = "0.1.0"
}
