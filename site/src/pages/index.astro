---
import Base from "../layouts/Base.astro";
import { getPacks, getCategories, REGISTRY_URL } from "../lib/packs.js";

const packs = await getPacks();
const categories = await getCategories();
const counts = Object.fromEntries(categories.map((c) => [c, packs.filter((p) => p.category === c).length]));
const base = import.meta.env.BASE_URL;
const addCmd = `nomad-pack registry add nomploy ${REGISTRY_URL}`;
---

<Base>
  <p class="tag">Batteries-included infrastructure for Nomad — one command to add, one to run.</p>

  <div class="addcmd">
    <div class="cmd" id="addcmd">{addCmd}</div>
    <button class="copy" data-copy="#addcmd">Copy</button>
  </div>

  <div class="controls">
    <input id="q" type="search" placeholder="Search packs…  ( / )" autocomplete="off" />
    <label class="sortwrap">
      <span>Sort</span>
      <select id="sort">
        <option value="name">Name (A–Z)</option>
        <option value="stars">Stars</option>
        <option value="category">Category</option>
        <option value="vars">Variables</option>
      </select>
    </label>
    <div class="chips" id="chips">
      <span class="chip on" data-cat="">All <span class="c">{packs.length}</span></span>
      {categories.map((c) => (
        <span class="chip" data-cat={c}>{c} <span class="c">{counts[c]}</span></span>
      ))}
    </div>
  </div>

  <div class="grid" id="grid">
    {
      packs.map((p) => (
        <a
          class="pcard"
          href={`${base}packs/${p.id}/`}
          data-name={p.name.toLowerCase()}
          data-desc={(p.description || "").toLowerCase()}
          data-cat={p.category}
          data-stars={p.stars ?? -1}
          data-vars={p.variables.length}
        >
          <div class="phead">
            {p.icon.kind === "brand" ? (
              <div class="logo" style={`color:${p.icon.hex}`} set:html={p.iconSvg} />
            ) : (
              <div class="logo mono" style={`background:${p.icon.color}`}>{p.icon.text}</div>
            )}
            <div class="pmeta">
              <div class="cat">{p.category}</div>
              <h3>{p.name} <span class="ver">v{p.version || "?"}</span></h3>
            </div>
          </div>
          <p>{p.description}</p>
          <div class="foot">
            <span>{p.variables.length} variables</span>
            {p.starsLabel && <span class="stars" title={`${p.stars.toLocaleString()} GitHub stars`}>★ {p.starsLabel}</span>}
            <span class="arrow">→</span>
          </div>
        </a>
      ))
    }
  </div>
  <div class="empty" id="empty" hidden>No packs match.</div>
  <p class="count" id="count">{packs.length} packs</p>
</Base>

<style>
  .tag { color: var(--muted); margin: 8px 0 20px; }
  .controls { position: sticky; top: 0; background: var(--bg); padding: 14px 0; z-index: 5; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; border-bottom: 1px solid var(--border); }
  #q { flex: 1; min-width: 220px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--text); font-size: 15px; }
  .sortwrap { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 13px; }
  .sortwrap select { padding: 9px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--text); font-size: 14px; cursor: pointer; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .chip { background: var(--chip); border: 1px solid var(--border); color: var(--muted); border-radius: 999px; padding: 5px 11px; font-size: 13px; cursor: pointer; user-select: none; display: inline-flex; align-items: center; gap: 6px; }
  .chip .c { font-size: 11px; opacity: .7; }
  .chip.on { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
  .chip.on .c { opacity: .85; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; padding: 20px 0 8px; }
  .pcard { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; box-shadow: var(--shadow); transition: transform .08s ease, border-color .12s ease; color: inherit; display: flex; flex-direction: column; }
  /* the author display:flex above beats the UA [hidden] rule, so filtering needs this */
  .pcard[hidden] { display: none !important; }
  .pcard:hover { transform: translateY(-2px); border-color: var(--accent); text-decoration: none; }
  .phead { display: flex; gap: 12px; align-items: center; margin-bottom: 10px; }
  .pmeta { min-width: 0; }
  .pcard h3 { margin: 2px 0 0; font-size: 17px; display: flex; align-items: center; gap: 8px; }
  .pcard p { margin: 0; color: var(--muted); font-size: 13.5px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { margin-top: 12px; color: var(--muted); font-size: 12px; display: flex; align-items: center; gap: 10px; }
  .foot .stars { color: #e3b341; font-weight: 600; }
  .foot .arrow { margin-left: auto; }
  .empty { color: var(--muted); padding: 40px 0; text-align: center; }
  .count { color: var(--muted); font-size: 13px; }
</style>

<script>
  const q = document.getElementById("q");
  const chips = document.getElementById("chips");
  const grid = document.getElementById("grid");
  const sortSel = document.getElementById("sort");
  const cards = [...document.querySelectorAll(".pcard")];
  const empty = document.getElementById("empty");
  const count = document.getElementById("count");
  const total = cards.length;
  let activeCat = "";

  const byName = (a, b) => a.dataset.name.localeCompare(b.dataset.name);
  const comparators = {
    name: byName,
    stars: (a, b) => (+b.dataset.stars - +a.dataset.stars) || byName(a, b),
    vars: (a, b) => (+b.dataset.vars - +a.dataset.vars) || byName(a, b),
    category: (a, b) => a.dataset.cat.localeCompare(b.dataset.cat) || byName(a, b),
  };

  function sortCards() {
    const cmp = comparators[sortSel.value] || byName;
    [...cards].sort(cmp).forEach((c) => grid.appendChild(c));
  }

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const okCat = !activeCat || c.dataset.cat === activeCat;
      const okText = !term || c.dataset.name.includes(term) || c.dataset.desc.includes(term);
      const show = okCat && okText;
      c.hidden = !show;
      if (show) shown++;
    }
    empty.hidden = shown > 0;
    count.textContent = shown === total ? `${total} packs` : `${shown} of ${total} packs`;
  }

  q.addEventListener("input", apply);
  sortSel.addEventListener("change", sortCards);
  chips.addEventListener("click", (e) => {
    const chip = e.target.closest(".chip");
    if (!chip) return;
    activeCat = chip.dataset.cat;
    chips.querySelectorAll(".chip").forEach((c) => c.classList.toggle("on", c === chip));
    apply();
  });

  // "/" focuses search; Escape clears it.
  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement !== q) { e.preventDefault(); q.focus(); }
    else if (e.key === "Escape" && document.activeElement === q) { q.value = ""; apply(); q.blur(); }
  });

  sortCards();

  document.querySelectorAll(".copy").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      const el = document.querySelector(btn.dataset.copy);
      try {
        await navigator.clipboard.writeText(el.textContent);
        const o = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = o), 1200);
      } catch {}
    });
  });
</script>
