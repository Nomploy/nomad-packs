app {
  url = "https://soketi.app"
}

pack {
  name        = "soketi"
  description = "soketi — a fast, open-source WebSocket server that is protocol-compatible with Pusher Channels, for real-time features (live updates, notifications, presence) in your apps. Deployed as a stateless host-networked Nomad service with a default app credential set. A self-hosted drop-in for Pusher."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/soketi"
  version     = "0.1.0"
}
