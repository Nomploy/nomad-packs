app {
  url = "https://khoj.dev"
}

pack {
  name        = "khoj"
  description = "Khoj — your self-hosted AI second brain: chat with your documents and the web, run local or cloud LLMs, and search your notes semantically. Deployed as an all-in-one host-networked Nomad job (PostgreSQL + pgvector + the Khoj server). First start downloads embedding models, so give it ~2 GB RAM."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/khoj"
  version     = "0.1.0"
}
