app {
  url = "https://pocket-id.org"
}

pack {
  name        = "pocket-id"
  description = "Pocket ID — a simple, passkey-first OpenID Connect (OIDC) provider: sign in to your self-hosted apps with WebAuthn passkeys, no passwords. Deployed as a single host-networked Nomad service on SQLite with a data volume. A lightweight alternative to keycloak/authentik for SSO."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/pocket-id"
  version     = "0.1.0"
}
