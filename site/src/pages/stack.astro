---
import Base from "../layouts/Base.astro";
import { getPacks, REGISTRY_URL } from "../lib/packs.js";
import { getStacks } from "../lib/stacks.js";

const stacks = getStacks();
const packs = await getPacks();
const data = packs.map((p) => ({
  id: p.id,
  name: p.name,
  category: p.category,
  ports: [...new Set(p.facts.ports.map((x) => parseInt(x.port, 10)).filter((n) => !Number.isNaN(n)))],
  tasks: p.facts.tasks || 0,
  volumes: p.facts.volumes.length,
  cpu: p.facts.cpu || 0,
  memory: p.facts.memory || 0,
  setvars: p.variables.filter((v) => v.placeholder || v.sensitive).map((v) => ({ name: v.name, ph: !!v.placeholder })),
  // Full variable surface for the combined values.hcl generator.
  vars: p.variables.map((v) => ({ name: v.name, def: v.default || "", desc: v.description || "", ph: !!v.placeholder, sec: !!v.sensitive })),
  related: (p.related || []).map((r) => r.id),
}));
const stacksData = stacks.map((s) => ({ id: s.id, name: s.name, packs: s.packs }));
const cats = [...new Set(data.map((d) => d.category))].sort();
const byCat = Object.fromEntries(cats.map((c) => [c, data.filter((d) => d.category === c).sort((a, b) => a.name.localeCompare(b.name))]));
const base = import.meta.env.BASE_URL;
---

<Base
  title="Stack builder — Nomploy Nomad Packs"
  description="Compose a self-hosted stack from Nomploy Nomad Packs and instantly catch host-port collisions before you deploy."
>
  <section class="hero">
    <h1>Stack builder</h1>
    <p class="lede">
      Pick the packs you want to run on one node. Because every pack is host-networked on static
      ports, the real risk when combining them is a <strong>port collision</strong> — this catches
      it before you deploy, and generates the commands.
    </p>
  </section>

  <div class="presets">
    <span class="plabel">Starter stacks</span>
    {stacks.map((s) => (
      <button class="preset" type="button" data-packs={s.packs.join(",")} data-stack={s.name} title={s.description}>{s.name}</button>
    ))}
    <button class="preset clear" type="button" data-packs="">Clear</button>
    <a class="preset-link" href={`${base}stacks/`}>Browse stacks →</a>
  </div>

  <div class="sb">
    <div class="picker">
      <input id="sfilter" type="search" placeholder="Filter packs…" autocomplete="off" />
      {cats.map((c) => (
        <div class="cat-group" data-cat={c}>
          <div class="cat-head">{c}</div>
          {byCat[c].map((d) => (
            <label class="row" data-name={d.id}>
              <input type="checkbox" value={d.id} />
              <span class="rn">{d.name}</span>
              <span class="rp">{d.ports.length ? d.ports.join(" · ") : "—"}</span>
            </label>
          ))}
        </div>
      ))}
    </div>

    <aside class="summary" id="summary">
      <div class="stitle" id="stitle">Your stack</div>
      <div class="scount"><b id="nsel">0</b> packs selected</div>
      <div class="stats">
        <span><b id="ntasks">0</b> tasks</span>
        <span><b id="nports">0</b> ports</span>
        <span><b id="nvols">0</b> volumes</span>
        <span><b id="nram">0</b> <span id="nramunit">MB RAM</span></span>
      </div>

      <div class="cap">
        <label class="caplabel">Node RAM <input id="capgb" type="number" min="1" step="1" value="8" /> GB</label>
        <div class="capbar"><div id="capfill" class="capfill"></div></div>
        <div id="capnote" class="capnote muted">Estimated RAM vs. your node's capacity.</div>
      </div>

      <div id="conflict" class="conflict" hidden></div>

      <div class="section-title">Selected packs</div>
      <div id="sellist" class="sellist"><p class="muted">Nothing selected yet — pick packs on the left or load a starter stack above.</p></div>

      <div id="suggestwrap" hidden>
        <div class="section-title">Suggested companions</div>
        <div id="suggest" class="suggest"></div>
      </div>

      <div class="section-title">Set before deploy</div>
      <div id="setvars" class="setvars"><p class="muted">Variables you must set (passwords, secrets, URLs) appear here per pack.</p></div>

      <div class="section-title">Host ports</div>
      <div id="portmap" class="portmap"><p class="muted">Select packs to see their ports.</p></div>

      <details class="valgen" id="valgen">
        <summary>Combined <code>values.hcl</code> + one-paste deploy script</summary>
        <div class="valgen-in">
          <p class="muted small" id="valnote">One editable <code>values.hcl</code> section per selected pack, plus a script that writes each file and runs the pack. Fill in the <span class="mustlabel">CHANGE ME</span> values first.</p>
          <div class="addcmd">
            <pre class="cmd" id="valscript">Select packs to generate the deploy script.</pre>
            <button class="copy" data-copy="#valscript">Copy</button>
          </div>
        </div>
      </details>

      <div class="section-title">Deploy</div>
      <div class="addcmd">
        <pre class="cmd" id="cmds">Select packs to generate commands.</pre>
        <button class="copy" data-copy="#cmds">Copy</button>
      </div>
      <div class="sharerow">
        <button class="ghost" id="sharebtn" type="button">Copy share link</button>
      </div>
      <p class="muted small">Pin stateful packs to one node with each pack's <code>constraints</code> variable, and set any <code>*_password</code> / <code>secret</code> before production. RAM is a rough estimate from each pack's default resource limits.</p>
    </aside>
  </div>

  <p class="back"><a href={base}>← Back to the catalog</a></p>

  <script type="application/json" id="stackdata" set:html={JSON.stringify(data)}></script>
  <script type="application/json" id="stacksdata" set:html={JSON.stringify(stacksData)}></script>
</Base>

<style>
  .hero { padding: 18px 20px; margin: 12px 0 16px; border: 1px solid var(--border); border-radius: 16px; background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 8%, var(--card)) 0%, var(--card) 60%); position: relative; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--brand-grad); }
  .hero h1 { margin: 2px 0 6px; font-size: 26px; letter-spacing: -.02em; background: var(--brand-grad); -webkit-background-clip: text; background-clip: text; color: transparent; display: inline-block; }
  .lede { color: var(--muted); margin: 0; max-width: 760px; }

  .presets { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; }
  .plabel { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .preset { background: var(--chip); border: 1px solid var(--border); color: var(--text); border-radius: 999px; padding: 6px 12px; font-size: 13px; cursor: pointer; }
  .preset:hover { border-color: var(--accent); }
  .preset.clear { color: var(--muted); }
  .preset-link { font-size: 13px; margin-left: auto; color: var(--accent); font-weight: 600; }

  .sb { display: grid; grid-template-columns: 1fr 400px; gap: 18px; align-items: start; }
  @media (max-width: 900px) { .sb { grid-template-columns: 1fr; } .summary { position: static !important; } }

  #sfilter { width: 100%; padding: 9px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--text); font-size: 14px; margin-bottom: 12px; }
  .cat-group { margin-bottom: 14px; }
  .cat-head { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 6px; }
  .row { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); margin-bottom: 6px; cursor: pointer; }
  .row:hover { border-color: var(--accent); }
  .row input { accent-color: var(--accent); width: 16px; height: 16px; }
  .rn { flex: 1; font-size: 14px; }
  .rp { font-family: ui-monospace, monospace; font-size: 12px; color: var(--muted); }
  .row.sel { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--card)); }

  .summary { position: sticky; top: 12px; border: 1px solid var(--border); border-radius: 12px; padding: 16px; background: var(--card); box-shadow: var(--shadow); overflow: hidden; }
  .summary::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--brand-grad); }
  .stitle { font-size: 17px; font-weight: 700; letter-spacing: -.01em; margin: 2px 0 8px; display: flex; align-items: center; gap: 8px; }
  .stitle .badge { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #fff; background: var(--brand-grad); border-radius: 999px; padding: 2px 9px; }
  .scount { font-size: 15px; } .scount b { font-size: 20px; }
  .sellist { display: flex; flex-direction: column; gap: 6px; }
  .sharerow { margin-top: 8px; }
  .ghost { background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 8px; padding: 7px 12px; font-size: 13px; cursor: pointer; }
  .ghost:hover { border-color: var(--accent); }
  .stats { display: flex; gap: 14px; flex-wrap: wrap; color: var(--muted); font-size: 13px; margin: 8px 0 4px; }
  .stats b { color: var(--text); }
  .cap { margin: 10px 0 4px; }
  .caplabel { font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
  .caplabel input { width: 60px; padding: 4px 6px; border: 1px solid var(--border); border-radius: 6px; background: var(--card); color: var(--text); font-size: 13px; }
  .capbar { height: 8px; border-radius: 999px; background: var(--chip); overflow: hidden; margin: 8px 0 6px; }
  .capfill { height: 100%; width: 0; background: var(--accent); transition: width .2s ease; }
  .capfill.warn { background: #f59e0b; }
  .capfill.over { background: #e5484d; }
  .capnote { font-size: 12.5px; }
  .capnote.over { color: #b42318; }
  :root[data-theme="dark"] .capnote.over { color: #ff9d94; }
  .section-title { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 18px 0 8px; }
  .portmap { display: flex; flex-direction: column; gap: 4px; }
  .conflict { border: 1px solid #f59e0b66; background: #f59e0b1a; color: #b45309; border-radius: 8px; padding: 9px 11px; font-size: 13px; margin-top: 10px; }
  :root[data-theme="dark"] .conflict { color: #fbbf24; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .conflict { color: #fbbf24; } }
  .conflict.ok { border-color: color-mix(in srgb, var(--accent) 50%, transparent); background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); }
  .cmd { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; font-size: 12.5px; overflow: auto; white-space: pre; font-family: ui-monospace, monospace; max-height: 260px; margin: 0; }
  .addcmd { display: flex; gap: 8px; align-items: flex-start; }
  .muted { color: var(--muted); } .small { font-size: 12px; }
  .back { margin: 22px 0 0; font-size: 13px; }
</style>

<!-- Global: the port-map rows and selected-pack items are built client-side via
     innerHTML, so scoped styles would not match them. -->
<style is:global>
  .selitem { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; background: color-mix(in srgb, var(--accent) 6%, var(--card)); }
  .selitem .si-name { font-weight: 600; font-size: 13.5px; }
  .selitem .si-cat { font-size: 11px; color: var(--muted); }
  .selitem .si-ports { margin-left: auto; font-family: ui-monospace, monospace; font-size: 11.5px; color: var(--muted); }
  .selitem .si-x { cursor: pointer; border: 0; background: none; color: var(--muted); font-size: 15px; line-height: 1; padding: 0 2px; }
  .selitem .si-x:hover { color: #b42318; }
  .setvars { display: flex; flex-direction: column; gap: 6px; }
  .setvars .svrow { font-size: 13px; line-height: 1.5; }
  .setvars .svp { font-weight: 600; color: var(--accent); }
  .setvars .svv code { font-family: ui-monospace, monospace; font-size: 11.5px; background: var(--code-bg); border: 1px solid var(--border); border-radius: 5px; padding: 1px 5px; margin: 0 2px 2px 0; display: inline-block; color: var(--muted); }
  .setvars .svv code.must { color: #b45309; border-color: #f59e0b66; background: #f59e0b1a; }
  :root[data-theme="dark"] .setvars .svv code.must { color: #fbbf24; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .setvars .svv code.must { color: #fbbf24; } }
  .portmap .pmrow { display: flex; align-items: baseline; gap: 10px; font-size: 13px; }
  .portmap .pmrow .pp { font-family: ui-monospace, monospace; font-weight: 700; min-width: 56px; flex: 0 0 auto; }
  .portmap .pmrow .pu { color: var(--muted); }
  .suggest { display: flex; flex-wrap: wrap; gap: 6px; }
  .suggest .sugg { cursor: pointer; font-size: 12.5px; color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--card)); border: 1px solid var(--border); border-radius: 999px; padding: 4px 11px; display: inline-flex; align-items: center; gap: 6px; }
  .suggest .sugg:hover { border-color: var(--accent); }
  .suggest .sugg .sg-cat { font-size: 10.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .valgen { margin: 6px 0 2px; }
  .valgen > summary { cursor: pointer; color: var(--accent); font-weight: 600; font-size: 13px; list-style: none; user-select: none; }
  .valgen > summary::-webkit-details-marker { display: none; }
  .valgen > summary::before { content: "▸ "; }
  .valgen[open] > summary::before { content: "▾ "; }
  .valgen-in { margin-top: 10px; }
  .mustlabel { color: #b45309; font-weight: 600; }
  :root[data-theme="dark"] .mustlabel { color: #fbbf24; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .mustlabel { color: #fbbf24; } }
  .portmap .pmrow.bad, .portmap .pmrow.bad .pp { color: #b42318; }
  :root[data-theme="dark"] .portmap .pmrow.bad, :root[data-theme="dark"] .portmap .pmrow.bad .pp { color: #ff9d94; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .portmap .pmrow.bad,
    :root:not([data-theme="light"]) .portmap .pmrow.bad .pp { color: #ff9d94; }
  }
</style>

<script is:inline>
  const DATA = JSON.parse(document.getElementById("stackdata").textContent);
  const STACKS = JSON.parse(document.getElementById("stacksdata").textContent);
  const byId = Object.fromEntries(DATA.map((d) => [d.id, d]));
  const REGISTRY = "github.com/Nomploy/nomad-packs";
  const boxes = [...document.querySelectorAll('.picker input[type=checkbox]')];
  const $ = (id) => document.getElementById(id);
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

  function selected() { return boxes.filter((b) => b.checked).map((b) => b.value); }

  // Name the selection when it exactly matches a curated stack.
  function matchStack(sel) {
    const set = [...sel].sort().join(",");
    const s = STACKS.find((s) => [...s.packs].sort().join(",") === set);
    return s ? s.name : null;
  }

  function recompute() {
    const sel = selected();
    $("nsel").textContent = sel.length;
    let tasks = 0, vols = 0, ram = 0;
    const portUsers = {}; // port -> [names]
    for (const id of sel) {
      const d = byId[id];
      tasks += d.tasks; vols += d.volumes; ram += d.memory || 0;
      for (const p of d.ports) (portUsers[p] ||= []).push(d.name);
    }
    $("ntasks").textContent = tasks;
    $("nvols").textContent = vols;
    $("nram").textContent = ram >= 1024 ? (ram / 1024).toFixed(1) : ram;
    $("nramunit").textContent = ram >= 1024 ? "GB RAM" : "MB RAM";

    // node capacity check
    const capMb = Math.max(1, (parseFloat($("capgb").value) || 0)) * 1024;
    const pct = ram / capMb;
    const fill = $("capfill"), note = $("capnote");
    fill.style.width = Math.min(100, pct * 100).toFixed(0) + "%";
    fill.classList.toggle("over", pct > 1);
    fill.classList.toggle("warn", pct > 0.8 && pct <= 1);
    note.classList.toggle("over", pct > 1);
    const gb = (n) => (n / 1024).toFixed(1);
    if (!sel.length) note.textContent = "Estimated RAM vs. your node's capacity.";
    else if (pct > 1) note.textContent = `~${gb(ram)} GB needed — over your ${gb(capMb)} GB node by ${gb(ram - capMb)} GB. Trim the stack or use a bigger node.`;
    else note.textContent = `~${gb(ram)} GB of ${gb(capMb)} GB used (${Math.round(pct * 100)}%) — fits.`;
    const ports = Object.keys(portUsers).map(Number).sort((a, b) => a - b);
    $("nports").textContent = ports.length;

    // title
    const named = matchStack(sel);
    const st = $("stitle");
    if (named) st.innerHTML = `<span class="badge">stack</span> ${esc(named)}`;
    else st.textContent = sel.length ? "Custom stack" : "Your stack";

    // selected packs list
    const sl = $("sellist");
    if (!sel.length) sl.innerHTML = '<p class="muted">Nothing selected yet — pick packs on the left or load a starter stack above.</p>';
    else sl.innerHTML = sel.map((id) => {
      const d = byId[id];
      return `<div class="selitem"><span class="si-name">${esc(d.name)}</span><span class="si-cat">${esc(d.category)}</span><span class="si-ports">${d.ports.join(" · ") || "—"}</span><button class="si-x" data-id="${id}" title="Remove" aria-label="Remove ${esc(d.name)}">✕</button></div>`;
    }).join("");

    // suggested companions: union of selected packs' "pairs with", minus already selected
    const selSet = new Set(sel);
    const suggScore = {};
    for (const id of sel) for (const r of (byId[id]?.related || [])) {
      if (selSet.has(r) || !byId[r]) continue;
      suggScore[r] = (suggScore[r] || 0) + 1;
    }
    const suggIds = Object.keys(suggScore).sort((a, b) => suggScore[b] - suggScore[a] || byId[a].name.localeCompare(byId[b].name)).slice(0, 8);
    const sw = $("suggestwrap"), sg = $("suggest");
    if (!suggIds.length) { sw.hidden = true; sg.innerHTML = ""; }
    else {
      sw.hidden = false;
      sg.innerHTML = suggIds.map((id) => {
        const d = byId[id];
        return `<button class="sugg" data-id="${id}" title="Add ${esc(d.name)} to the stack">+ ${esc(d.name)} <span class="sg-cat">${esc(d.category)}</span></button>`;
      }).join("");
    }

    // variables to set (placeholders/secrets) per pack
    const sv = $("setvars");
    if (!sel.length) {
      sv.innerHTML = '<p class="muted">Variables you must set (passwords, secrets, URLs) appear here per pack.</p>';
    } else {
      const rows = sel.map((id) => byId[id]).filter((d) => d.setvars && d.setvars.length);
      sv.innerHTML = rows.length
        ? rows.map((d) => `<div class="svrow"><a class="svp" href="../packs/${d.id}/">${esc(d.name)}</a> <span class="svv">${d.setvars.map((v) => `<code class="${v.ph ? "must" : ""}">${esc(v.name)}</code>`).join(" ")}</span></div>`).join("")
        : '<p class="muted">No secrets flagged — sensible defaults, but review each pack before production.</p>';
    }

    // port map
    const pm = $("portmap");
    if (!sel.length) { pm.innerHTML = '<p class="muted">Select packs to see their ports.</p>'; }
    else {
      pm.innerHTML = ports.map((p) => {
        const users = portUsers[p];
        const bad = users.length > 1;
        return `<div class="pmrow ${bad ? "bad" : ""}"><span class="pp">${p}</span><span class="pu">${users.join(", ")}${bad ? " ⚠ conflict" : ""}</span></div>`;
      }).join("");
    }

    // conflict banner
    const conflicts = ports.filter((p) => portUsers[p].length > 1);
    const cf = $("conflict");
    if (!sel.length) { cf.hidden = true; }
    else if (conflicts.length) {
      cf.hidden = false; cf.classList.remove("ok");
      cf.innerHTML = `⚠ ${conflicts.length} port ${conflicts.length === 1 ? "conflict" : "conflicts"} (${conflicts.join(", ")}). Change the port variable on one of the clashing packs, or run them on different nodes.`;
    } else {
      cf.hidden = false; cf.classList.add("ok");
      cf.textContent = "✓ No host-port conflicts in this selection.";
    }

    // commands
    const cmds = $("cmds");
    if (!sel.length) { cmds.textContent = "Select packs to generate commands."; }
    else {
      cmds.textContent = [`nomad-pack registry add nomploy ${REGISTRY}`, ...sel.map((id) => `nomad-pack run ${id} --registry nomploy`)].join("\n");
    }

    // combined values.hcl + one-paste deploy script
    const vg = $("valscript");
    if (!sel.length) { vg.textContent = "Select packs to generate the deploy script."; }
    else {
      // "notable" = worth overriding: placeholders, secrets, ports, urls, images, emails.
      const notable = (v) => v.ph || v.sec || /(?:^|_)port$|_url$|^base_url$|^image$|_password$|_email$|_key$|secret/i.test(v.name);
      const lines = [`nomad-pack registry add nomploy ${REGISTRY}`, ""];
      for (const id of sel) {
        const d = byId[id];
        const vs = (d.vars || []).filter(notable);
        if (!vs.length) {
          lines.push(`# ${d.name} — defaults are fine, run as-is`, `nomad-pack run ${id} --registry nomploy`, "");
          continue;
        }
        lines.push(`# ${d.name} — edit values below, then it deploys`);
        lines.push(`cat > ${id}.values.hcl <<'HCL'`);
        for (const v of vs) {
          if (v.desc) lines.push(`# ${v.desc}`);
          const flag = (v.ph || v.sec) ? "   # <-- CHANGE ME" : "";
          const val = v.def !== "" ? v.def : '""';
          lines.push(`${v.name} = ${val}${flag}`);
        }
        lines.push("HCL");
        lines.push(`nomad-pack run ${id} -f ${id}.values.hcl --registry nomploy`);
        lines.push("");
      }
      vg.textContent = lines.join("\n").replace(/\n+$/, "\n");
    }
  }

  boxes.forEach((b) => b.addEventListener("change", () => {
    b.closest(".row").classList.toggle("sel", b.checked);
    recompute();
  }));

  $("capgb").addEventListener("input", recompute);

  // filter
  const sf = $("sfilter");
  sf?.addEventListener("input", () => {
    const t = sf.value.trim().toLowerCase();
    for (const row of document.querySelectorAll(".picker .row")) {
      row.style.display = !t || row.dataset.name.includes(t) ? "" : "none";
    }
    for (const g of document.querySelectorAll(".cat-group")) {
      const any = [...g.querySelectorAll(".row")].some((r) => r.style.display !== "none");
      g.style.display = any ? "" : "none";
    }
  });

  document.querySelectorAll(".copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = document.querySelector(btn.dataset.copy);
      try {
        await navigator.clipboard.writeText(el.textContent);
        const o = btn.textContent; btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = o), 1200);
      } catch (e) {}
    });
  });

  // Apply a set of pack ids to the checkboxes (replaces the current selection).
  function applySelection(ids) {
    const want = new Set(ids.filter((id) => byId[id]));
    for (const b of boxes) {
      b.checked = want.has(b.value);
      b.closest(".row").classList.toggle("sel", b.checked);
    }
    recompute();
  }

  // Remove a pack from the selected-packs list (✕ buttons, delegated).
  $("sellist").addEventListener("click", (e) => {
    const x = e.target.closest(".si-x");
    if (!x) return;
    const b = boxes.find((b) => b.value === x.dataset.id);
    if (b) { b.checked = false; b.closest(".row").classList.remove("sel"); recompute(); }
  });

  // Add a suggested companion to the selection (delegated).
  $("suggest").addEventListener("click", (e) => {
    const s = e.target.closest(".sugg");
    if (!s) return;
    const b = boxes.find((b) => b.value === s.dataset.id);
    if (b) { b.checked = true; b.closest(".row").classList.add("sel"); recompute(); }
  });

  // Share link: current selection as ?packs=…
  $("sharebtn").addEventListener("click", async () => {
    const sel = selected();
    const url = location.origin + location.pathname + (sel.length ? "?packs=" + sel.join(",") : "");
    try {
      await navigator.clipboard.writeText(url);
      const b = $("sharebtn"), o = b.textContent; b.textContent = "Link copied!";
      setTimeout(() => (b.textContent = o), 1200);
    } catch (e) {}
  });

  // Starter-stack preset buttons.
  document.querySelectorAll(".preset").forEach((btn) => {
    btn.addEventListener("click", () => {
      applySelection((btn.dataset.packs || "").split(",").filter(Boolean));
      document.getElementById("summary").scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  // Prefill from ?packs=a,b,c (shareable / "Open in Stack builder" links).
  const pre = new URLSearchParams(location.search).get("packs");
  if (pre) applySelection(pre.split(",").filter(Boolean));

  recompute();
</script>
