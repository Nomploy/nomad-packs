app {
  url = "https://tinyauth.app"
}

pack {
  name        = "tinyauth"
  description = "Tinyauth — a tiny authentication middleware that adds a login screen (and optional OAuth/LDAP) in front of any app behind your reverse proxy via forward-auth. Deployed as a single host-networked Nomad service."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/tinyauth"
  version     = "0.1.0"
}
