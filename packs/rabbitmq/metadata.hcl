app {
  url = "https://www.rabbitmq.com"
}

pack {
  name        = "rabbitmq"
  description = "RabbitMQ — a battle-tested message broker (AMQP 0-9-1, plus MQTT/STOMP) with the management UI enabled. Deployed as a host-networked Nomad service with a persistent Docker volume and a stable node name so its data survives reschedules."
