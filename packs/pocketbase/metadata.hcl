app {
  url = "https://pocketbase.io"
}

pack {
  name        = "pocketbase"
  description = "PocketBase — an open-source backend in a single file: an embedded SQLite database with realtime subscriptions, built-in auth, file storage, and an admin dashboard, exposed over a REST-ish API. Deployed as a host-networked Nomad service with a persistent volume."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/pocketbase"
  version     = "0.1.0"
}
