app {
  url = "https://postgrest.org"
}

pack {
  name        = "postgrest"
  description = "PostgREST — turns any PostgreSQL database directly into a fast, RESTful API. It serves a full CRUD API driven by your schema, roles, and views, with JWT auth and row-level security — no backend code required. Deployed as a host-networked, stateless Nomad service (bring your own PostgreSQL)."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/postgrest"
  version     = "0.1.0"
}
