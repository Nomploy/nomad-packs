app {
  url = "https://pairdrop.net"
}

pack {
  name        = "pairdrop"
  description = "PairDrop — a browser-based, AirDrop-style file and text sharing tool: send between devices on the same network (peer-to-peer via WebRTC) or paired remotely, with no app and no account. Deployed as a stateless host-networked Nomad service."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/pairdrop"
  version     = "0.1.0"
}
