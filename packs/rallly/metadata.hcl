app {
  url = "https://rallly.co"
}

pack {
  name        = "rallly"
  description = "Rallly — a self-hosted meeting scheduling and group-poll tool (a Doodle alternative): create date/time polls, collect availability, and pick the best slot without the back-and-forth. Deployed as an all-in-one host-networked Nomad job: a PostgreSQL sidecar plus the Rallly app with a persistent database volume."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/rallly"
  version     = "0.1.0"
}
