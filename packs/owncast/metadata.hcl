app {
  url = "https://owncast.online"
}

pack {
  name        = "owncast"
  description = "Owncast — a self-hosted live streaming and chat server, an open-source alternative to Twitch/YouTube Live: stream over RTMP and viewers watch on your own web page with built-in chat. Deployed as a single host-networked Nomad service on SQLite with a data volume."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/owncast"
  version     = "0.1.0"
}
