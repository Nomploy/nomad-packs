app {
  url = "https://turso.tech/libsql"
}

pack {
  name        = "libsql"
  description = "libSQL server (sqld) — a self-hosted server for libSQL, the open-source fork of SQLite by Turso. Get SQLite's simplicity with a network HTTP/gRPC API, so multiple apps and edge clients can share one database. Deployed as a host-networked Nomad service with a persistent data volume."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/libsql"
  version     = "0.1.0"
}
