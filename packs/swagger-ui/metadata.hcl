app {
  url = "https://swagger.io/tools/swagger-ui/"
}

pack {
  name        = "swagger-ui"
  description = "Swagger UI — a browser interface that renders any OpenAPI/Swagger spec into interactive, try-it-out API documentation. Point it at a spec URL and get explorable docs. Deployed as a host-networked, stateless Nomad service."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/swagger-ui"
  version     = "0.1.0"
}
