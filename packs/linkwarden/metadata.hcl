app {
  url = "https://linkwarden.app"
}

pack {
  name        = "linkwarden"
  description = "Linkwarden — a self-hosted bookmark manager that also archives a full copy of each link (screenshot, PDF, readable text) so pages survive link rot. Organize with collections, tags, and sharing. Deployed as an all-in-one host-networked Nomad job: a PostgreSQL sidecar plus the Linkwarden app."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/linkwarden"
  version     = "0.1.0"
}
