---
import Base from "../../layouts/Base.astro";
import { getPacks } from "../../lib/packs.js";

export async function getStaticPaths() {
  return (await getPacks()).map((p) => ({ params: { id: p.id }, props: { pack: p } }));
}

const { pack } = Astro.props;
const base = import.meta.env.BASE_URL;
const runCmd = `nomad-pack run ${pack.id} --registry nomploy`;

// A ready-to-edit HCL var file: every variable, its description as a comment, and its default.
const valuesHcl =
  pack.variables.map((v) => `# ${v.description}\n${v.name} = ${v.default || "\"\""}`).join("\n\n") + "\n";
const valuesRun = `nomad-pack run ${pack.id} -f values.hcl --registry nomploy`;

const site = Astro.site ?? new URL("https://packs.nomploy.com");
const jsonld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: pack.name,
  description: pack.description,
  applicationCategory: `${pack.category} · Nomad Pack`,
  operatingSystem: "HashiCorp Nomad",
  softwareVersion: pack.version,
  url: new URL(`packs/${pack.id}/`, site).href,
  ...(pack.repo ? { codeRepository: `https://github.com/${pack.repo}` } : {}),
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base title={`${pack.name} — Nomploy Nomad Packs`} description={pack.description} jsonld={jsonld} image={`og/${pack.id}.png`}>
  <p class="crumb"><a href={base}>← All packs</a></p>

  <div class="head">
    {pack.icon.kind === "brand" ? (
      <div class="logo logo-lg" style={`color:${pack.icon.hex}`} set:html={pack.iconSvg} />
    ) : (
      <div class="logo logo-lg mono" style={`background:${pack.icon.color}`}>{pack.icon.text}</div>
    )}
    <div>
      <h1>{pack.name} <span class="ver">v{pack.version || "?"}</span></h1>
      <span class="cat">{pack.category}</span>
    </div>
  </div>
  <p class="desc">{pack.description}</p>

  <div class="addcmd">
    <div class="cmd" id="runcmd">{runCmd}</div>
    <button class="copy" data-copy="#runcmd">Copy</button>
  </div>
  <p class="links">
    <a href={pack.sourceUrl} target="_blank" rel="noopener">Source ↗</a>
    {pack.appUrl && <a href={pack.appUrl} target="_blank" rel="noopener">Project ↗</a>}
    {pack.repo && (
      <a class="stars" href={`https://github.com/${pack.repo}`} target="_blank" rel="noopener" title={pack.stars != null ? `${pack.stars.toLocaleString()} GitHub stars` : "GitHub repository"}>
        ★ {pack.starsLabel || "GitHub"}
      </a>
    )}
  </p>

  {
    pack.facts && (pack.facts.ports.length > 0 || pack.facts.volumes.length > 0 || pack.facts.tasks > 0) && (
      <div class="facts">
        {pack.facts.tasks > 0 && (
          <span class="fact"><span class="fk">{pack.facts.tasks}</span> {pack.facts.tasks === 1 ? "task" : "tasks"}</span>
        )}
        {pack.facts.ports.map((p) => (
          <span class="fact port" title={`${p.name} port`}>{p.name} <span class="fk">{p.port}</span></span>
        ))}
        {pack.facts.volumes.length > 0 && (
          <span class="fact" title={pack.facts.volumes.join("\n")}>
            <span class="fk">{pack.facts.volumes.length}</span> {pack.facts.volumes.length === 1 ? "volume" : "volumes"}
          </span>
        )}
        {pack.facts.image && (
          <span class="fact img" title="container image"><span class="mut">image</span> {pack.facts.image}</span>
        )}
      </div>
    )
  }

  {
    pack.related && pack.related.length > 0 && (
      <div class="related">
        <span class="rlabel">Pairs with</span>
        {pack.related.map((r) => (
          <a class="rchip" href={`${base}packs/${r.id}/`}>{r.name}</a>
        ))}
      </div>
    )
  }

  {
    pack.alternatives && pack.alternatives.length > 0 && (
      <div class="related">
        <span class="rlabel">Alternatives</span>
        {pack.alternatives.map((r) => (
          <a class="rchip alt" href={`${base}packs/${r.id}/`}>{r.name}</a>
        ))}
      </div>
    )
  }

  {
    pack.variables.length > 0 && (
      <>
        <div class="vtop">
          <div class="section-title" style="margin:0">Variables <span class="vcount">{pack.variables.length}</span></div>
          <input id="vfilter" type="search" placeholder="Filter variables…" autocomplete="off" />
          <details class="valbox">
            <summary>values.hcl</summary>
            <div class="valinner">
              <p class="valhint">Save as <code>values.hcl</code>, edit, then run:</p>
              <div class="addcmd">
                <div class="cmd" id="valuesrun">{valuesRun}</div>
                <button class="copy" data-copy="#valuesrun">Copy</button>
              </div>
              <div class="addcmd">
                <pre class="valpre" id="valueshcl">{valuesHcl}</pre>
                <button class="copy" data-copy="#valueshcl">Copy file</button>
              </div>
            </div>
          </details>
        </div>
        <table class="vartable">
          <thead>
            <tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr>
          </thead>
          <tbody id="vbody">
            {pack.variables.map((v) => (
              <tr class="vrow" data-name={v.name} data-desc={(v.description || "").toLowerCase()}>
                <td class="vname">
                  <span class="mono">{v.name}</span>
                  {v.placeholder && <span class="vtag set" title="Placeholder default — set this before production">set me</span>}
                  {v.sensitive && !v.placeholder && <span class="vtag sec" title="Sensitive value">key</span>}
                </td>
                <td><span class={`vkind k-${v.kind}`} title={v.type || v.kind}>{v.kind}</span></td>
                <td>{v.default ? <pre class="def">{v.default}</pre> : <span class="mut">—</span>}</td>
                <td>{v.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="vempty" id="vempty" hidden>No variables match.</p>
      </>
    )
  }

  {
    pack.readmeHtml && (
      <>
        <div class="section-title">Readme</div>
        <div class="md" set:html={pack.readmeHtml} />
      </>
    )
  }
</Base>

<style>
  .crumb { margin: 16px 0 0; font-size: 13px; }
  .head { display: flex; align-items: center; gap: 12px; margin-top: 10px; flex-wrap: wrap; }
  .head h1 { margin: 0; font-size: 26px; letter-spacing: -.02em; }
  .desc { color: var(--muted); margin: 6px 0 16px; }
  .links { display: flex; gap: 14px; flex-wrap: wrap; font-size: 13px; margin: 8px 0 0; }
  .links .stars { color: #e3b341; font-weight: 600; }

  .facts { display: flex; gap: 8px; flex-wrap: wrap; margin: 16px 0 0; }
  .fact { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--muted); background: var(--chip); border: 1px solid var(--border); border-radius: 8px; padding: 4px 10px; }
  .fact.port { font-family: ui-monospace, monospace; }
  .fact.img { font-family: ui-monospace, monospace; }
  .fact .fk { font-weight: 700; color: var(--text); font-family: ui-monospace, monospace; }
  .fact .mut { color: var(--muted); font-weight: 600; text-transform: uppercase; font-size: 10.5px; letter-spacing: .04em; }

  .related { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 14px 0 0; }
  .rlabel { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .rchip { font-size: 13px; color: var(--accent); background: var(--chip); border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px; }
  .rchip:hover { border-color: var(--accent); text-decoration: none; }
  .rchip.alt { color: var(--muted); }
  .rchip.alt:hover { color: var(--accent); }

  .vtop { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 28px 0 8px; }
  .vcount { font-size: 12px; font-weight: 600; color: var(--muted); background: var(--chip); border-radius: 999px; padding: 1px 8px; margin-left: 4px; }
  #vfilter { flex: 1; min-width: 180px; padding: 8px 11px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--text); font-size: 14px; }
  .valbox { font-size: 13px; }
  .valbox > summary { cursor: pointer; color: var(--accent); font-weight: 600; list-style: none; padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); user-select: none; }
  .valbox > summary::-webkit-details-marker { display: none; }
  .valbox[open] > summary { border-color: var(--accent); }
  .valinner { margin-top: 10px; }
  .valhint { color: var(--muted); margin: 0 0 8px; }
  .valpre { flex: 1; min-width: 260px; margin: 0; background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-size: 12.5px; line-height: 1.5; overflow: auto; max-height: 340px; white-space: pre; font-family: ui-monospace, monospace; }

  .vname { white-space: nowrap; }
  .vtag { display: inline-block; margin-left: 8px; font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; border-radius: 5px; padding: 1px 6px; vertical-align: middle; }
  .vtag.set { background: #f59e0b22; color: #b45309; border: 1px solid #f59e0b55; }
  .vtag.sec { background: var(--chip); color: var(--muted); }
  :root[data-theme="dark"] .vtag.set { color: #fbbf24; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .vtag.set { color: #fbbf24; } }
  .vkind { display: inline-block; font-size: 11px; font-weight: 600; border-radius: 6px; padding: 2px 8px; background: var(--chip); color: var(--muted); font-family: ui-monospace, monospace; }
  .k-string { color: #0d9488; } .k-number { color: #7c3aed; } .k-bool { color: #d97706; }
  .k-list, .k-set, .k-tuple { color: #0ea5e9; } .k-object, .k-map { color: #db2777; }
  :root[data-theme="dark"] .k-string { color: #2dd4bf; } :root[data-theme="dark"] .k-number { color: #a78bfa; }
  :root[data-theme="dark"] .k-bool { color: #fbbf24; } :root[data-theme="dark"] .k-list, :root[data-theme="dark"] .k-set, :root[data-theme="dark"] .k-tuple { color: #38bdf8; }
  :root[data-theme="dark"] .k-object, :root[data-theme="dark"] .k-map { color: #f472b6; }
  .def { margin: 0; font-family: ui-monospace, monospace; font-size: 12.5px; white-space: pre-wrap; word-break: break-word; max-height: 200px; overflow: auto; max-width: 340px; }
  .mut { color: var(--muted); }
  .vempty { color: var(--muted); padding: 20px 0; }
</style>

<script>
  document.querySelectorAll(".copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = document.querySelector(btn.dataset.copy);
      try {
        await navigator.clipboard.writeText(el.textContent);
        const o = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = o), 1200);
      } catch {}
    });
  });

  // Filter the variables table by name/description.
  const vf = document.getElementById("vfilter");
  if (vf) {
    const rows = [...document.querySelectorAll(".vrow")];
    const vempty = document.getElementById("vempty");
    vf.addEventListener("input", () => {
      const t = vf.value.trim().toLowerCase();
      let shown = 0;
      for (const r of rows) {
        const ok = !t || r.dataset.name.includes(t) || r.dataset.desc.includes(t);
        r.hidden = !ok;
        if (ok) shown++;
      }
      if (vempty) vempty.hidden = shown > 0;
    });
  }
</script>
