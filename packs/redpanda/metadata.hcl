app {
  url = "https://redpanda.com"
}

pack {
  name        = "redpanda"
  description = "Redpanda — a Kafka-compatible streaming data platform in a single binary (no ZooKeeper/JVM), with a Kafka API, HTTP proxy, and schema registry. Deployed here as a single-node dev-container instance, host-networked with a data volume. A lighter drop-in for Apache Kafka."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/redpanda"
  version     = "0.1.0"
}
