app {
  url = "https://prowlarr.com"
}

pack {
  name        = "prowlarr"
  description = "Prowlarr — an indexer manager for the *arr media stack: configure your torrent and Usenet indexers once and Prowlarr syncs them to Sonarr, Radarr, Lidarr, and friends, with search and stats. Deployed as a host-networked Nomad service with a persistent config volume."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/prowlarr"
  version     = "0.1.0"
}
