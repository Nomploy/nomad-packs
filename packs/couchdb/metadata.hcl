app {
  url = "https://couchdb.apache.org"
}

pack {
  name        = "couchdb"
  description = "Apache CouchDB — a document database with a JSON document model, an HTTP/REST API, and multi-master replication (great for offline-first / sync apps). Deployed as a host-networked Nomad service with a persistent volume and the Fauxton admin UI."
  url         = "https://github.com/Nomploy/nomad-packs/tree/main/packs/couchdb"
  version     = "0.1.0"
}
